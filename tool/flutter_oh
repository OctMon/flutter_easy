#!/usr/bin/env bash
set -euo pipefail

task_project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
task_flutter_home="${FLUTTER_OH_HOME:-$(dirname "$task_project_root")/sdk/flutter-oh-3.41.10-ohos-1.0.1}"
task_deveco_home="${DEVECO_HOME:-/Applications/DevEco-Studio.app/Contents}"

if [[ ! -x "$task_flutter_home/bin/flutter" ]]; then
  printf 'Flutter OH was not found at %s. Set FLUTTER_OH_HOME to its SDK directory.\n' "$task_flutter_home" >&2
  exit 1
fi

# Apply the HarmonyOS tools only to this process and its children.
export PATH="$task_flutter_home/bin:$task_deveco_home/tools/node/bin:$task_deveco_home/tools/ohpm/bin:$task_deveco_home/tools/hvigor/bin:$task_deveco_home/sdk/default/openharmony/toolchains:$PATH"
export FLUTTER_GIT_URL="https://gitcode.com/CPF-Flutter/flutter_flutter.git"

if [[ -d "$task_deveco_home/jbr/Contents/Home" ]]; then
  export JAVA_HOME="$task_deveco_home/jbr/Contents/Home"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

if [[ -x "$task_deveco_home/tools/node/bin/node" ]]; then
  export NODE_HOME="$task_deveco_home/tools/node"
fi

if [[ -d "$task_deveco_home/sdk" ]]; then
  export DEVECO_SDK_HOME="$task_deveco_home/sdk"
fi

# This SDK is pinned to a release tag; skip background checks that fetch tags.
exec "$task_flutter_home/bin/flutter" --no-version-check "$@"
